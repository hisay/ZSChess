// 中文(简体，中国) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_CHS)
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_ZSCHESS             ICON                    "ZSChess.ico"

IDI_SMALL               ICON                    "small.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_ZSCHESS MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "新局(&N)",                      ID_NEWGAME
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)",                      IDM_EXIT
    END
    POPUP "棋局(&E)"
    BEGIN
        MENUITEM "悔棋(&B)\tCtrl+B",              ID_BACKSTEP
        MENUITEM "棋谱上一步\t←",                    ID_RECORD_STEPBACK
        MENUITEM "棋谱下一步\t→",                    ID_RECORD_STEPFWD
        MENUITEM SEPARATOR
        MENUITEM "保存棋谱(&S)...",                 ID_RECORD_SAVE
        MENUITEM "加载棋谱(&L)...",                 ID_RECORD_LOAD
        MENUITEM "复制当前局面(&C)",                  ID_RECORD_COPY
        MENUITEM SEPARATOR
        MENUITEM "黑棋AI(&E)\tCtrl+V",            ID_BLACKAI
        MENUITEM "红棋AI(&R)\tCtrl+R",            ID_REDAI
        MENUITEM SEPARATOR
        MENUITEM "AI 设置(&C)",                   ID_AI_CONFIG
        MENUITEM SEPARATOR
        MENUITEM "自动训练模式(&T)...",               ID_TRAIN_MODE
        MENUITEM "停止训练(&S)",                    ID_STOP_TRAIN
        MENUITEM SEPARATOR
        MENUITEM "继续棋局(&I)",                    ID_RECORD_LOAD
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "关于(&A) ...",                  IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_ZSCHESS ACCELERATORS
BEGIN
    "^B",           ID_BACKSTEP,            ASCII,  NOINVERT
    "^N",           ID_NEWGAME,             ASCII,  NOINVERT
    "/",            IDM_ABOUT,              ASCII,  ALT, NOINVERT
    "?",            IDM_ABOUT,              ASCII,  ALT, NOINVERT
    "^V",           ID_BLACKAI,             ASCII,  NOINVERT
    "^R",           ID_REDAI,               ASCII,  NOINVERT
    VK_LEFT,        ID_RECORD_STEPBACK,     VIRTKEY, NOINVERT
    VK_RIGHT,       ID_RECORD_STEPFWD,      VIRTKEY, NOINVERT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于 ZSChess"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDI_ZSCHESS,IDC_STATIC,14,14,21,20
    LTEXT           "ZSChess, 版本 1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "版权所有(c) 2026",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "确定",IDOK,113,41,50,14,WS_GROUP
END

IDD_TRAIN_CONFIG DIALOGEX 0, 0, 230, 128
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "自动训练模式"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "红方等级:",-1,10,14,70,12
    COMBOBOX        IDC_TRAIN_RED_TIER,90,12,120,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "黑方等级:",-1,10,38,70,12
    COMBOBOX        IDC_TRAIN_BLACK_TIER,90,36,120,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "局数(0=无限):",-1,10,62,90,12
    EDITTEXT        IDC_TRAIN_GAMES,110,60,60,18,ES_NUMBER
    LTEXT           "训练结果自动存入神经网络库 nn_lib 并每局保存棋谱",-1,10,86,210,18
    DEFPUSHBUTTON   "开始",IDOK,168,106,52,14
    PUSHBUTTON      "取消",IDCANCEL,108,106,52,14
END

IDD_AI_CONFIG DIALOGEX 0, 0, 210, 140
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "AI 设置"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "对局 AI 等级:",-1,10,8,70,12
    COMBOBOX        IDC_AI_LEVEL,80,7,41,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "搜索深度:",-1,10,30,60,12
    EDITTEXT        IDC_AI_DEPTH,80,28,40,18,ES_AUTOHSCROLL
    LTEXT           "最大线程:",-1,10,50,60,12
    EDITTEXT        IDC_AI_MAXTHREADS,80,48,40,18,ES_NUMBER
    LTEXT           "Time(sec):",-1,10,72,60,12
    EDITTEXT        IDC_AI_TIME,80,70,40,18,ES_NUMBER
    CONTROL         "启用启发",IDC_AI_HEUR,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,130,8,70,16
    CONTROL         "优先杀王",IDC_AI_PREFERMATE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,130,28,70,16
    CONTROL         "使用AI等级参数",IDC_AI_USE_TIER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,130,48,80,16
    LTEXT           "等级参数读取 ai_config.ini [level0..5]",-1,10,92,190,12
    DEFPUSHBUTTON   "确定",IDOK,120,110,50,14
    PUSHBUTTON      "取消",IDCANCEL,60,110,50,14
END


